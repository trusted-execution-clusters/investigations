# Build TEC CoreOS images (fcos / scos / rhcos)
# Usage:
#   just build                        # build FCOS container image
#   just os=scos build                # build SCOS container image
#   just os=rhcos build               # build RHCOS (needs REGISTRY_AUTH_FILE)
#   just build-qemu                   # build QEMU disk image (needs KVM)
#   KBC_IMG=<img> just build          # override component image for testing
#   OS_VERSION=9.8 just os=rhcos build


os := "fcos"

# Upstream configs (provides osbuild support, platforms.yaml, BUILDER_IMG)
fcos_base_config := "https://github.com/coreos/fedora-coreos-config"                                                                                                                                       
scos_base_config := "https://github.com/coreos/rhel-coreos-config.git"
rhcos_base_config := scos_base_config

# TEC overlay configs (Containerfile, build-args, versionary, usr/)
fcos_tec_config := "https://github.com/trusted-execution-clusters/fedora-coreos-tec-config"
rhcos_tec_config := "https://github.com/trusted-execution-clusters/rhel-coreos-tec-config"
scos_tec_config := rhcos_tec_config

# Base images — empty means use TEC config's build-args.conf default
# SCOS needs explicit override: shares rhcos TEC config which has RHCOS base (requires auth)
fcos_base_img  := env("FCOS_BASE_IMG", "")
scos_base_img  := env("SCOS_BASE_IMG", "quay.io/okd/scos-content@sha256:f4b90ebda72d56ad89e4b33099c12f0f94321366ccf615b97fb7158f684e6fea")
rhcos_base_img := env("RHCOS_BASE_IMG", "")

base_img := if os == "rhcos" { rhcos_base_img } else { if os == "scos" { scos_base_img } else { fcos_base_img } }

base_config := if os == "rhcos" { rhcos_base_config } else { if os == "scos" { scos_base_config } else { fcos_base_config } }                                                                              
tec_config := if os == "rhcos" { rhcos_tec_config } else { if os == "scos" { scos_tec_config } else { fcos_tec_config } }

kbc_image := env("KBC_IMG", "")
clevis_pin_trustee_image := env("CLEVIS_PIN_IMG", "")
ignition_image := env("IGNITION_IMG", "")
os_version := env("OS_VERSION", "")


# cosa function
cosa_function := '''
    #!/usr/bin/env bash
    cosa() {
        env | grep COREOS_ASSEMBLER || true
        local -r COREOS_ASSEMBLER_CONTAINER_LATEST="quay.io/coreos-assembler/coreos-assembler:latest"
        if [[ -z ${COREOS_ASSEMBLER_CONTAINER} ]] && $(podman image exists ${COREOS_ASSEMBLER_CONTAINER_LATEST}); then
            local -r cosa_build_date_str="$(podman inspect -f "{{.Created}}" ${COREOS_ASSEMBLER_CONTAINER_LATEST} | awk '{print $1}')"
            local -r cosa_build_date="$(date -d ${cosa_build_date_str} +%s)"
            if [[ $(date +%s) -ge $((cosa_build_date + 60*60*24*7)) ]] ; then
                echo -e "\e[0;33m----" >&2
                echo "The COSA container image is more than a week old and likely outdated." >&2
                echo "You should pull the latest version with:" >&2
                echo "podman pull ${COREOS_ASSEMBLER_CONTAINER_LATEST}" >&2
                echo -e "----\e[0m" >&2
                sleep 10
            fi
        fi
        set -x
        podman run --rm -ti --security-opt=label=disable --privileged \
            --userns=keep-id:uid=1000,gid=1000 \
            -v=${PWD}:/srv/ --device=/dev/kvm --device=/dev/fuse \
            --tmpfs=/tmp -v=/var/tmp:/var/tmp --name=cosa \
            ${REGISTRY_AUTH_FILE:+-v=$REGISTRY_AUTH_FILE:$REGISTRY_AUTH_FILE:ro -e REGISTRY_AUTH_FILE} \
            ${COREOS_ASSEMBLER_CONFIG_GIT:+-v=$COREOS_ASSEMBLER_CONFIG_GIT:/srv/src/config/:ro} \
            ${COREOS_ASSEMBLER_GIT:+-v=$COREOS_ASSEMBLER_GIT/src/:/usr/lib/coreos-assembler/:ro} \
            ${COREOS_ASSEMBLER_ADD_CERTS:+-v=/etc/pki/ca-trust:/etc/pki/ca-trust:ro} \
            ${COREOS_ASSEMBLER_CONTAINER_RUNTIME_ARGS} \
            ${COREOS_ASSEMBLER_CONTAINER:-$COREOS_ASSEMBLER_CONTAINER_LATEST} "$@"
        rc=$?; set +x; return $rc
    }
'''

info:
    @echo "os {{os}}"
    @echo "base_config {{base_config}}"
    @echo "tec_config {{tec_config}}"
    @echo "kbc_image {{kbc_image}}"
    @echo "clevis_pin_trustee_image {{clevis_pin_trustee_image}}"
    @echo "ignition_image {{ignition_image}}"
    @echo "base_img {{base_img}}"
    @echo "os_version {{os_version}}" 


build:
    #!/usr/bin/env bash
    set -ex
    podman rm -f cosa 2>/dev/null || true
    {{cosa_function}}
    mkdir -p cache
    cd cache
    # 1. Init with upstream config (provides osbuild, platforms.yaml, BUILDER_IMG)
    cosa init --force {{base_config}}

    # 2. Save upstream BUILDER_IMG before overlay
    BUILDER_IMG=$(grep '^BUILDER_IMG=' src/config/build-args.conf 2>/dev/null || echo "")
    [ -z "$BUILDER_IMG" ] && echo "WARNING: BUILDER_IMG not found in upstream, osbuild will lack python3" >&2

    # 3. Clone TEC config and overlay (Containerfile, build-args, manifest, versionary, usr/)
    rm -rf /tmp/tec-overlay
    git clone --depth=1 --recurse-submodules {{tec_config}} /tmp/tec-overlay
    cp /tmp/tec-overlay/Containerfile src/config/
    
    # 4. build-args: FCOS uses build-args.conf, RHCOS uses build-args-<ver>.conf
    BUILD_ARGS=$(ls /tmp/tec-overlay/build-args.conf 2>/dev/null || \
                ls /tmp/tec-overlay/build-args-*.conf 2>/dev/null | head -1)
    if [ -z "$BUILD_ARGS" ]; then
        echo "ERROR: no build-args.conf found in TEC config" >&2; exit 1
    fi
    cp "$BUILD_ARGS" src/config/build-args.conf
    [ -n "{{base_img}}" ] && sed -i "s|^BASE=.*|BASE={{base_img}}|" src/config/build-args.conf

    # 5. Override the osversion 
    [ -n "{{os_version}}" ] && sed -i "s|^VERSION=.*|VERSION={{os_version}}|" src/config/build-args.conf

    cp /tmp/tec-overlay/manifest.yaml src/config/
    cp /tmp/tec-overlay/versionary src/config/
    cp -rL /tmp/tec-overlay/usr src/config/
    rm -rf /tmp/tec-overlay
    echo "!/usr/" >> src/config/.containerignore

    # 6. Restore upstream BUILDER_IMG (needed for osbuild buildroot with python3)
    if [ -n "$BUILDER_IMG" ]; then
        echo "$BUILDER_IMG" >> src/config/build-args.conf
    fi

    # 7. Apply env overrides if set
    [ -n "{{kbc_image}}" ] && sed -i "s|^KBC_IMG=.*|KBC_IMG={{kbc_image}}|" src/config/build-args.conf
    [ -n "{{clevis_pin_trustee_image}}" ] && sed -i "s|^CLEVIS_PIN_IMG=.*|CLEVIS_PIN_IMG={{clevis_pin_trustee_image}}|" src/config/build-args.conf
    [ -n "{{ignition_image}}" ] && sed -i "s|^IGNITION_IMG=.*|IGNITION_IMG={{ignition_image}}|" src/config/build-args.conf
    cosa build

build-qemu:
    #!/usr/bin/env bash
    set -ex
    podman rm -f cosa 2>/dev/null || true
    {{cosa_function}}
    cd cache
    cosa osbuild qemu

kubevirt:
    #!/usr/bin/env bash
    set -ex
    podman rm -f cosa 2>/dev/null || true
    {{cosa_function}}
    cd cache
    cosa osbuild kubevirt

azure:
    #!/usr/bin/env bash
    set -ex
    podman rm -f cosa 2>/dev/null || true
    {{cosa_function}}
    cd cache
    cosa osbuild azure
