# Build TEC CoreOS images (fcos / scos / rhcos)

os := "fcos"

# Branch configuration (override with env vars)
fcos_branch := env_var_or_default("FCOS_TEC_BRANCH", "main")
rhcos_branch := env_var_or_default("RHCOS_BRANCH", "main")
tec_submodule_branch := env_var_or_default("TEC_SUBMODULE_BRANCH", "main")


# TEC overlay configs (Containerfile, build-args, versionary, usr/)
fcos_tec_config := env_var_or_default("FCOS_TEC_CONFIG", "https://github.com/trusted-execution-clusters/fedora-coreos-tec-config")
rhcos_config := env_var_or_default("RHCOS_CONFIG", "https://github.com/coreos/rhel-coreos-config")
scos_config := rhcos_config

config_repo := if os == "rhcos" { rhcos_config } else { if os == "scos" { scos_config } else { fcos_tec_config } }

# Internal RHCOS yum repos (set RHCOS_REPO env var for internal builds)
rhcos_repo := env_var_or_default("RHCOS_REPO", "")

# cosa function
cosa_function := '''
    #!/usr/bin/env bash
    cosa() {
        env | grep COREOS_ASSEMBLER || true
        local -r COREOS_ASSEMBLER_CONTAINER_LATEST="quay.io/coreos-assembler/coreos-assembler:latest"
        if [[ -z ${COREOS_ASSEMBLER_CONTAINER} ]] && $(podman image exists ${COREOS_ASSEMBLER_CONTAINER_LATEST}); then
            local -r cosa_build_date_str="$(podman inspect -f "{{.Created}}" ${COREOS_ASSEMBLER_CONTAINER_LATEST} | awk '{print $1}')"
            local -r cosa_build_date="$(date -d ${cosa_build_date_str} +%s)"
            if [[ $(date +%s) -ge $((cosa_build_date + 60*60*24*7)) ]] ; then
                echo -e "\e[0;33m----" >&2
                echo "The COSA container image is more than a week old and likely outdated." >&2
                echo "You should pull the latest version with:" >&2
                echo "podman pull ${COREOS_ASSEMBLER_CONTAINER_LATEST}" >&2
                echo -e "----\e[0m" >&2
                sleep 10
            fi
        fi
        set -x
        podman run --rm -ti --security-opt=label=disable --privileged \
            --userns=keep-id:uid=1000,gid=1000 \
            -v=${PWD}:/srv/ --device=/dev/kvm --device=/dev/fuse \
            --tmpfs=/tmp -v=/var/tmp:/var/tmp --name=cosa \
            ${REGISTRY_AUTH_FILE:+-v=$REGISTRY_AUTH_FILE:/run/user/1000/containers/auth.json:ro -e REGISTRY_AUTH_FILE=/run/user/1000/containers/auth.json} \
            ${COREOS_ASSEMBLER_CONFIG_GIT:+-v=$COREOS_ASSEMBLER_CONFIG_GIT:/srv/src/config/:ro} \
            ${COREOS_ASSEMBLER_GIT:+-v=$COREOS_ASSEMBLER_GIT/src/:/usr/lib/coreos-assembler/:ro} \
            ${COREOS_ASSEMBLER_ADD_CERTS:+-v=/etc/pki/ca-trust:/etc/pki/ca-trust:ro} \
            ${COREOS_ASSEMBLER_CONTAINER_RUNTIME_ARGS} \
            ${COREOS_ASSEMBLER_CONTAINER:-$COREOS_ASSEMBLER_CONTAINER_LATEST} "$@"
        rc=$?; set +x; return $rc
    }
'''

info:
    #!/usr/bin/env bash
    echo "=== Build Configuration ==="
    echo "OS: {{os}}"
    echo "Config Repo: {{config_repo}}"
    echo ""
    if [ "{{os}}" = "rhcos" ] || [ "{{os}}" = "scos" ]; then
        echo "RHCOS-specific variables:"
        echo "  RHCOS_BRANCH: {{rhcos_branch}}"
        echo "  TEC_SUBMODULE_BRANCH: {{tec_submodule_branch}}"
        echo "  RHCOS_REPO: ${RHCOS_REPO:-not set}"
        echo "  REGISTRY_AUTH_FILE=<location of auth.json>"
        echo ""
        echo "To override:"
        echo "  RHCOS_BRANCH=my-branch just os={{os}} build"
        echo "  TEC_SUBMODULE_BRANCH=my-submodule-branch just os={{os}} build"
        echo "  RHCOS_REPO=http://repo-url COREOS_ASSEMBLER_ADD_CERTS=y REGISTRY_AUTH_FILE=<location of auth.json> just os={{os}} build"
    else
        echo "FCOS-specific variables:"
        echo "  FCOS_TEC_BRANCH: {{fcos_branch}}"
        echo ""
        echo "To override:"
        echo "  FCOS_TEC_BRANCH=my-branch just build"
    fi


build:
    #!/usr/bin/env bash
    set -ex
    podman rm -f cosa 2>/dev/null || true
    {{cosa_function}}
    mkdir -p cache
    cd cache
    
    # Initialize cosa with appropriate config
    if [[ -n "${RHCOS_REPO}" ]]; then
        # we create src/ directory to have the right permissions. This is useful when COREOS_ASSEMBLER_CONFIG_GIT is set.
        # This var make cosa mount the config repo in src/config. When mounting the volume, it creates src/ with root permissions.
        mkdir -p src
        rm -rf src/yumrepos
        cosa init --force \
            --yumrepos "${RHCOS_REPO}" \
            --branch {{rhcos_branch}} \
            {{config_repo}}
    else
        cosa init --force --branch {{fcos_branch}} {{config_repo}}
    fi
    
    # For testing/Development RHCOS builds: ensure tec-coreos-config submodule is on correct branch
    # (rhel-coreos-tec-config includes fedora-coreos-tec-config as submodule)
    if [[ "${os}" == "rhcos" ]]; then 
       cd src/config/tec-coreos-config
       git fetch origin {{tec_submodule_branch}}:{{tec_submodule_branch}}  
       git checkout {{tec_submodule_branch}}
       cd ../../../ 
    fi
    
    ## (buildah: true doesn't auto-use overrides/ due to build context isolation)
    # ----  Uncomment the following using the binaries or rpm ---
    #if [[ -d overrides/rootfs/usr/bin ]]; then
    #    mkdir -p src/config/tec-coreos-config/usr/bin
    #    echo "INFO: Copying test binaries from overrides/rootfs/usr/bin/"
    #    cp -v overrides/rootfs/usr/bin/{trustee-attester,clevis-pin-trustee,clevis-encrypt-trustee,clevis-decrypt-trustee} \
    #       src/config/tec-coreos-config/usr/bin/ 2>/dev/null || true
    #fi

    ## Copy RPMs into build context for local DNF install
    #if [[ -d overrides/rpm ]]; then
    #    mkdir -p src/config/tec-coreos-config/rpms
    #    echo "INFO: Copying RPMs from overrides/rpm/"
    #    cp -v overrides/rpm/*.rpm src/config/tec-coreos-config/rpms/ 2>/dev/null || true
    #fi

    cosa build ostree --skip-prune --file off-layering/cocl/Containerfile

build-qemu:
    #!/usr/bin/env bash
    set -ex
    podman rm -f cosa 2>/dev/null || true
    {{cosa_function}}
    cd cache
    cosa osbuild qemu

kubevirt:
    #!/usr/bin/env bash
    set -ex
    podman rm -f cosa 2>/dev/null || true
    {{cosa_function}}
    cd cache
    cosa osbuild kubevirt

azure:
    #!/usr/bin/env bash
    set -ex
    podman rm -f cosa 2>/dev/null || true
    {{cosa_function}}
    cd cache
    cosa osbuild azure

